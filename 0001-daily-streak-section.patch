+def today_contribution_count(days: list[dict]) -> int:
+    """Contribution count for the most recent day present in the fetched
+    calendar. GitHub's calendar is date-based (UTC), so the last entry in
+    the chronologically sorted list IS "today" for the account's calendar.
+    """
+    if not days:
+        return 0
+    return days[-1]["count"]
+
+
+def recent_activity(days: list[dict], n: int = 14) -> list[dict]:
+    """Last `n` calendar days (chronological, oldest first), for the
+    'recent daily activity' strip. Simply the tail of the already-sorted
+    `days` list -- no separate API call needed.
+    """
+    return days[-n:] if len(days) >= n else list(days)
+
+
